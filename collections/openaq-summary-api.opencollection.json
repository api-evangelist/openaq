{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages Summary API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Summary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Platform Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/summary",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a summary of platform data"
        }
      ]
    }
  ],
  "bundled": true
}