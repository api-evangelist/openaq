{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages Project API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Project",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Project by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a project by project ID"
        }
      ]
    }
  ],
  "bundled": true
}