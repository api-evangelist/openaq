{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages Sources API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/sources",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Change the number of results returned. e.g. limit=1000 will return up to 1000 results"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Paginate through results. e.g. page=1 will return first page of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Define sort order. e.g. ?sort=asc"
              },
              {
                "name": "source_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "source_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "source_slug",
                "value": "",
                "type": "query"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field by which to order the results e.g. ?order_by=sourceName or ?order_by=firstUpdated"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a list of sources"
        },
        {
          "info": {
            "name": "OpenAQ Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/sources",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a list of sources"
        },
        {
          "info": {
            "name": "OpenAQ Source Readme",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/sources/readme/:slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a readme for a given source by the source slug"
        }
      ]
    }
  ],
  "bundled": true
}