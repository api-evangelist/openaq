{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages Flags API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Flags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Get flags by location ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/locations/:locations_id/flags",
            "params": [
              {
                "name": "locations_id",
                "value": "",
                "type": "path",
                "description": "Limit the results to a specific locations"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Change the number of results returned.\n        e.g. limit=100 will return up to 100 results"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Paginate through results. e.g. page=1 will return first page of results"
              },
              {
                "name": "datetime_from",
                "value": "",
                "type": "query",
                "description": "To when?"
              },
              {
                "name": "datetime_to",
                "value": "",
                "type": "query",
                "description": "To when?"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a list of flags by location ID"
        },
        {
          "info": {
            "name": "OpenAQ Get flags by sensor ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/sensors/:sensor_id/flags",
            "params": [
              {
                "name": "sensor_id",
                "value": "",
                "type": "path",
                "description": "Limit the results to a specific sensor"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Change the number of results returned.\n        e.g. limit=100 will return up to 100 results"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Paginate through results. e.g. page=1 will return first page of results"
              },
              {
                "name": "datetime_from",
                "value": "",
                "type": "query",
                "description": "To when?"
              },
              {
                "name": "datetime_to",
                "value": "",
                "type": "query",
                "description": "To when?"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a list of flags by sensor ID"
        }
      ]
    }
  ],
  "bundled": true
}