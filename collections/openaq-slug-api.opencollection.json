{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages Slug API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Slug",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Source Readme",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/sources/readme/:slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a readme for a given source by the source slug"
        }
      ]
    }
  ],
  "bundled": true
}