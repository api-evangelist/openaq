{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages Owners API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Owners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Get a owner by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/owners/:owners_id",
            "params": [
              {
                "name": "owners_id",
                "value": "",
                "type": "path",
                "description": "Limit the results to a specific owner by id"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a owner by owner ID"
        },
        {
          "info": {
            "name": "OpenAQ Get owners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/owners",
            "params": [
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field by which to order results"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort results ascending or descending. Default ASC"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Change the number of results returned.\n        e.g. limit=100 will return up to 100 results"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Paginate through results. e.g. page=1 will return first page of results"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Provides a list of owners"
        }
      ]
    }
  ],
  "bundled": true
}