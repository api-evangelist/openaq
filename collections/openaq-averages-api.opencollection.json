{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAQ Averages API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Averages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAQ Get averaged values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/averages",
            "params": [
              {
                "name": "temporal",
                "value": "",
                "type": "query",
                "description": "Period to aggregate. month, day, hour"
              },
              {
                "name": "parameters_id",
                "value": "",
                "type": "query",
                "description": "What measurand would you like?"
              },
              {
                "name": "date_to",
                "value": "",
                "type": "query",
                "description": "To when?"
              },
              {
                "name": "date_from",
                "value": "",
                "type": "query",
                "description": "From when?"
              },
              {
                "name": "locations_id",
                "value": "",
                "type": "query",
                "description": "Limit the results to a specific location by id"
              },
              {
                "name": "spatial",
                "value": "",
                "type": "query",
                "description": "Define how you want to aggregate in space"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Change the number of results returned.\n        e.g. limit=100 will return up to 100 results"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Paginate through results. e.g. page=1 will return first page of results"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "OpenAQ Get averaged values"
        }
      ]
    }
  ],
  "bundled": true
}